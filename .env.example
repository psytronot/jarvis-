# J.A.R.V.I.S. — local environment
# Keep OPENAI_API_KEY server-side. Never rename it to VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Local bridge (loopback is the safe default).
# JARVIS_BRIDGE_PORT=8787
# JARVIS_BRIDGE_HOST=127.0.0.1
# JARVIS_ALLOWED_ORIGINS=

# Optional browser-side capabilities.
# VITE_PICOVOICE_ACCESS_KEY=
# VITE_TTS_ENGINE=system
# VITE_KOKORO_VOICE=bm_george
